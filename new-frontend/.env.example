# Stellar payments (pricing page "Pay with Stellar (USDC)" button)
# -------------------------------------------------------------------
# "testnet" or "mainnet". Keep on testnet until the full flow has been verified end to end.
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# BlockRoll's own Stellar public key that receives Premium payments.
# It MUST already have a USDC trustline established (via Freighter or the Stellar Laboratory)
# before going live, otherwise payments will fail with `op_no_trust`.
NEXT_PUBLIC_STELLAR_TREASURY_ADDRESS=

# Price of Premium, denominated in USDC.
NEXT_PUBLIC_STELLAR_PREMIUM_PRICE_USDC=99

# Optional overrides for the USDC issuer account per network.
# Defaults to Circle's official issuers - verify at
# https://developers.circle.com/stablecoins/quickstarts/transfer-usdc-stellar before overriding.
NEXT_PUBLIC_STELLAR_USDC_ISSUER_TESTNET=
NEXT_PUBLIC_STELLAR_USDC_ISSUER_MAINNET=
